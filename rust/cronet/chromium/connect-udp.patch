+++ b/src/components/cronet/native/udp_tunnel.cc
@@ -0,0 +1,445 @@
+// Copyright 2026 The Hikkari Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/cronet/native/udp_tunnel.h"
+
+#include <errno.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <utility>
+
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/strings/escape.h"
+#include "base/strings/stringprintf.h"
+#include "base/synchronization/waitable_event.h"
+#include "base/task/current_thread.h"
+#include "components/cronet/cronet_context.h"
+#include "components/cronet/native/engine.h"
+#include "net/base/host_port_pair.h"
+#include "net/base/http_user_agent_settings.h"
+#include "net/base/network_anonymization_key.h"
+#include "net/base/proxy_chain.h"
+#include "net/base/proxy_server.h"
+#include "net/base/schemeful_site.h"
+#include "net/cert/cert_verifier.h"
+#include "net/http/http_network_session.h"
+#include "net/http/http_request_headers.h"
+#include "net/http/http_transaction_factory.h"
+#include "net/socket/socket_tag.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "net/url_request/url_request_context.h"
+#include "url/gurl.h"
+#include "url/scheme_host_port.h"
+
+namespace cronet {
+
+namespace {
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("cronet_udp_tunnel", R"(
+      semantics {
+        sender: "Cronet UDP tunnel"
+        description: "A CONNECT-UDP tunnel the embedder opened."
+        trigger: "Cronet_UdpTunnel_Create."
+        data: "The embedder's datagrams."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "None."
+        policy_exception_justification: "Embedder's own traffic."
+      })");
+
+// The largest datagram either way: an HTTP Datagram never carries more than
+// a QUIC DATAGRAM frame, which is under 64 KiB.
+constexpr int kMaxDatagram = 65536;
+
+// Datagrams from the embedder taken in one wake, so that a busy embedder
+// cannot keep the network thread from its other sockets.
+constexpr int kUpPerWake = 64;
+
+}  // namespace
+
+// Adds the embedder's headers to the CONNECT-UDP request: the socket asks a
+// ProxyDelegate for them (QuicProxyDatagramClientSocket::DoCalculateHeaders)
+// and has no other way in. It answers nothing else.
+class UdpTunnel::Headers : public net::ProxyDelegate {
+ public:
+  explicit Headers(
+      const std::vector<std::pair<std::string, std::string>>& headers) {
+    for (const auto& [key, value] : headers) {
+      headers_.SetHeader(key, value);
+    }
+  }
+
+  void OnResolveProxy(const GURL&,
+                      const net::NetworkAnonymizationKey&,
+                      const std::string&,
+                      const net::ProxyRetryInfoMap&,
+                      net::ProxyInfo*) override {}
+  void OnFallback(const net::ProxyChain&, int) override {}
+  void OnSuccessfulRequestAfterFailures(const net::ProxyRetryInfoMap&) override {
+  }
+  base::expected<net::HttpRequestHeaders, net::Error> OnBeforeTunnelRequest(
+      const net::ProxyChain&,
+      size_t,
+      OnBeforeTunnelRequestCallback) override {
+    return headers_;
+  }
+  net::Error OnTunnelHeadersReceived(const net::ProxyChain&,
+                                     size_t,
+                                     const net::HttpResponseHeaders&,
+                                     net::CompletionOnceCallback) override {
+    return net::OK;
+  }
+  void SetProxyResolutionService(net::ProxyResolutionService*) override {}
+
+ private:
+  net::HttpRequestHeaders headers_;
+};
+
+UdpTunnel::UdpTunnel(CronetContext* context, Params params)
+    : context_(context),
+      params_(std::move(params)),
+      fd_watcher_(FROM_HERE),
+      up_buf_(base::MakeRefCounted<net::IOBufferWithSize>(kMaxDatagram)),
+      down_buf_(base::MakeRefCounted<net::IOBufferWithSize>(kMaxDatagram)) {}
+
+UdpTunnel::~UdpTunnel() {
+  fd_watcher_.StopWatchingFileDescriptor();
+  socket_.reset();
+  session_.reset();
+  session_request_.reset();
+  if (params_.fd >= 0) {
+    close(params_.fd);
+  }
+}
+
+void UdpTunnel::Start() {
+  DCHECK(context_->IsOnNetworkThread());
+  net::URLRequestContext* request_context = context_->GetURLRequestContext();
+  net::HttpNetworkSession* network_session =
+      request_context->http_transaction_factory()->GetSession();
+  if (!network_session || !network_session->quic_session_pool()) {
+    Close(net::ERR_NOT_IMPLEMENTED);
+    return;
+  }
+  net_log_ = net::NetLogWithSource::Make(request_context->net_log(),
+                                         net::NetLogSourceType::NONE);
+  headers_ = std::make_unique<Headers>(params_.headers);
+
+  // A direct session at the RFC version (there is no Alt-Svc to choose by),
+  // used as the embedder says: kDestination is Chrome's session to a site
+  // (packets of quic::kDefaultMaxPacketSize, 1250 B), kProxy its session to
+  // an IP Protection proxy, as QuicSessionPool::ProxyJob asks it (100 B
+  // more, QuicParams::additional_proxy_packet_length). The wire is the
+  // same otherwise.
+  const bool proxy = params_.session_usage == Cronet_UdpTunnel_SESSION_PROXY;
+  net::NetworkAnonymizationKey nak;
+  if (!params_.isolation_key.empty()) {
+    nak = net::NetworkAnonymizationKey::CreateSameSite(
+        net::SchemefulSite(GURL(params_.isolation_key)));
+  }
+  url::SchemeHostPort destination(url::kHttpsScheme, params_.proxy_host,
+                                  params_.proxy_port);
+  session_request_ = std::make_unique<net::QuicSessionRequest>(
+      network_session->quic_session_pool());
+  int rv = session_request_->Request(
+      destination, quic::ParsedQuicVersion::RFCv1(), net::ProxyChain::Direct(),
+      kTrafficAnnotation, request_context->http_user_agent_settings(),
+      proxy ? net::SessionUsage::kProxy : net::SessionUsage::kDestination,
+      net::PRIVACY_MODE_DISABLED, net::HIGHEST, net::SocketTag(), nak,
+      net::SecureDnsPolicy::kAllow,
+      /*require_dns_https_alpn=*/false,
+      // A session to a proxy never fetches for its certificate (the pool
+      // CHECKs it for SessionUsage::kProxy, as ProxyJob sets it); one to a
+      // site may, as Chrome's does.
+      proxy ? net::CertVerifier::VERIFY_DISABLE_NETWORK_FETCHES : 0,
+      GURL(destination.Serialize()), net::handles::kInvalidNetworkHandle,
+      net_log_, &net_error_details_,
+      net::MultiplexedSessionCreationInitiator::kUnknown,
+      /*management_config=*/std::nullopt,
+      /*failed_on_default_network_callback=*/net::CompletionOnceCallback(),
+      base::BindOnce(&UdpTunnel::OnSession, weak_factory_.GetWeakPtr()));
+  if (rv != net::ERR_IO_PENDING) {
+    OnSession(rv);
+  }
+}
+
+void UdpTunnel::OnSession(int rv) {
+  if (rv != net::OK) {
+    Close(rv);
+    return;
+  }
+  session_ = session_request_->ReleaseSessionHandle();
+  session_request_.reset();
+  if (!session_) {
+    Close(net::ERR_CONNECTION_CLOSED);
+    return;
+  }
+  // As ProxyJob::DoCreateProxyStream: wait for the handshake's
+  // confirmation, so that the tunnel is built on a working connection.
+  rv = session_->RequestStream(
+      /*requires_confirmation=*/true,
+      base::BindOnce(&UdpTunnel::OnStream, weak_factory_.GetWeakPtr()),
+      kTrafficAnnotation);
+  if (rv != net::ERR_IO_PENDING) {
+    OnStream(rv);
+  }
+}
+
+void UdpTunnel::OnStream(int rv) {
+  if (rv != net::OK) {
+    Close(rv);
+    return;
+  }
+  std::unique_ptr<net::QuicChromiumClientStream::Handle> stream =
+      session_->ReleaseStream();
+  if (!stream || !stream->IsOpen()) {
+    Close(net::ERR_CONNECTION_CLOSED);
+    return;
+  }
+  net::IPEndPoint local_address;
+  net::IPEndPoint proxy_address;
+  rv = session_->GetSelfAddress(&local_address);
+  if (rv == net::OK) {
+    rv = session_->GetPeerAddress(&proxy_address);
+  }
+  if (rv != net::OK) {
+    Close(rv);
+    return;
+  }
+  // RFC 9298, section 3: the default URI template.
+  GURL url(base::StringPrintf(
+      "https://%s:%d/.well-known/masque/udp/%s/%d/", params_.proxy_host.c_str(),
+      params_.proxy_port,
+      base::EscapeQueryParamValue(params_.target_host, false).c_str(),
+      params_.target_port));
+  net::ProxyChain chain(net::ProxyServer(
+      net::ProxyServer::SCHEME_QUIC,
+      net::HostPortPair(params_.proxy_host, params_.proxy_port)));
+  std::string user_agent;
+  if (const net::HttpUserAgentSettings* settings =
+          context_->GetURLRequestContext()->http_user_agent_settings()) {
+    user_agent = settings->GetUserAgent();
+  }
+  socket_ = std::make_unique<net::QuicProxyDatagramClientSocket>(
+      url, chain, user_agent, net_log_, headers_.get());
+  rv = socket_->ConnectViaStream(
+      local_address, proxy_address, std::move(stream),
+      base::BindOnce(&UdpTunnel::OnConnected, weak_factory_.GetWeakPtr()));
+  if (rv != net::ERR_IO_PENDING) {
+    OnConnected(rv);
+  }
+}
+
+void UdpTunnel::OnConnected(int rv) {
+  if (rv != net::OK) {
+    Close(rv);
+    return;
+  }
+  if (!base::CurrentIOThread::Get()->WatchFileDescriptor(
+          params_.fd, /*persistent=*/true, base::MessagePumpForIO::WATCH_READ,
+          &fd_watcher_, this)) {
+    Close(net::ERR_UNEXPECTED);
+    return;
+  }
+  params_.callback(params_.callback_context, Cronet_UdpTunnel_UP, net::OK);
+  if (!closed_) {
+    ReadFromProxy();
+  }
+}
+
+void UdpTunnel::OnFileCanReadWithoutBlocking(int fd) {
+  for (int i = 0; i < kUpPerWake && !closed_; i++) {
+    ssize_t n = recv(fd, up_buf_->data(), kMaxDatagram, MSG_DONTWAIT);
+    if (n < 0) {
+      if (errno == EINTR) {
+        continue;
+      }
+      if (errno != EAGAIN && errno != EWOULDBLOCK) {
+        Close(net::ERR_CONNECTION_RESET);
+      }
+      return;
+    }
+    // An empty message is an empty datagram: the embedder's end is a
+    // datagram socket (Cronet_UdpTunnelParams.fd), so it is carried too.
+    // The write is synchronous: the datagram is in a QUIC packet or dropped
+    // by the connection (too big, blocked), as a UDP datagram would be.
+    int rv = socket_->Write(up_buf_.get(), static_cast<int>(n),
+                            base::DoNothing(), kTrafficAnnotation);
+    if (rv >= 0) {
+      stats_.up_sent++;
+    } else if (rv == net::ERR_CONNECTION_CLOSED ||
+               rv == net::ERR_SOCKET_NOT_CONNECTED) {
+      Close(rv);
+      return;
+    } else {
+      stats_.up_dropped++;
+    }
+  }
+}
+
+void UdpTunnel::OnFileCanWriteWithoutBlocking(int fd) {}
+
+void UdpTunnel::ReadFromProxy() {
+  while (!closed_) {
+    int rv = socket_->Read(
+        down_buf_.get(), kMaxDatagram,
+        base::BindOnce(&UdpTunnel::OnReadFromProxy, weak_factory_.GetWeakPtr()));
+    if (rv == net::ERR_IO_PENDING || !Deliver(rv)) {
+      return;
+    }
+  }
+}
+
+void UdpTunnel::OnReadFromProxy(int rv) {
+  if (Deliver(rv)) {
+    ReadFromProxy();
+  }
+}
+
+bool UdpTunnel::Deliver(int rv) {
+  if (rv == 0) {
+    // The socket reads 0 once the request stream is closed.
+    Close(net::ERR_CONNECTION_CLOSED);
+    return false;
+  }
+  if (rv == net::ERR_MSG_TOO_BIG) {
+    stats_.down_dropped++;
+    return true;
+  }
+  if (rv < 0) {
+    Close(rv);
+    return false;
+  }
+  stats_.down_received++;
+  for (;;) {
+    ssize_t n = send(params_.fd, down_buf_->data(), rv, MSG_DONTWAIT);
+    if (n >= 0) {
+      return true;
+    }
+    if (errno == EINTR) {
+      continue;
+    }
+    if (errno == EAGAIN || errno == EWOULDBLOCK || errno == ENOBUFS) {
+      // The embedder is behind: drop, as a full UDP receive buffer would.
+      stats_.down_dropped++;
+      return true;
+    }
+    Close(net::ERR_CONNECTION_RESET);
+    return false;
+  }
+}
+
+void UdpTunnel::Close(int net_error) {
+  if (closed_) {
+    return;
+  }
+  closed_ = true;
+  fd_watcher_.StopWatchingFileDescriptor();
+  socket_.reset();
+  params_.callback(params_.callback_context, Cronet_UdpTunnel_CLOSED,
+                   net_error);
+}
+
+}  // namespace cronet
+
+namespace {
+
+// Runs `task` on the engine's network thread and waits for it, or runs it
+// right away when called there.
+void RunOnNetworkThread(cronet::CronetContext* context,
+                        base::OnceClosure task) {
+  if (context->IsOnNetworkThread()) {
+    std::move(task).Run();
+    return;
+  }
+  base::WaitableEvent done;
+  context->PostTaskToNetworkThread(
+      FROM_HERE, std::move(task).Then(base::BindOnce(
+                     &base::WaitableEvent::Signal, base::Unretained(&done))));
+  done.Wait();
+}
+
+}  // namespace
+
+struct Cronet_UdpTunnel {
+  raw_ptr<cronet::CronetContext> context;
+  std::unique_ptr<cronet::UdpTunnel> tunnel;
+};
+
+CRONET_EXPORT Cronet_UdpTunnelPtr
+Cronet_UdpTunnel_Create(Cronet_EnginePtr engine,
+                        const Cronet_UdpTunnelParams* params,
+                        Cronet_UdpTunnelCallback callback,
+                        void* callback_context) {
+  cronet::CronetContext* context =
+      static_cast<cronet::Cronet_EngineImpl*>(engine)
+          ->cronet_url_request_context();
+  if (!context || !params || !callback || params->fd < 0 ||
+      !params->proxy_host || !params->target_host) {
+    return nullptr;
+  }
+  cronet::UdpTunnel::Params p;
+  p.proxy_host = params->proxy_host;
+  p.proxy_port = params->proxy_port;
+  p.target_host = params->target_host;
+  p.target_port = params->target_port;
+  if (params->header_count > 0 && params->headers) {
+    // SAFETY: the C API's contract, cronet_c.h Cronet_UdpTunnelParams:
+    // `headers` points to `header_count` entries.
+    auto headers = UNSAFE_BUFFERS(
+        base::span(params->headers, params->header_count));
+    for (const Cronet_UdpTunnelHeader& h : headers) {
+      if (h.key && h.value) {
+        p.headers.emplace_back(h.key, h.value);
+      }
+    }
+  }
+  if (params->isolation_key) {
+    p.isolation_key = params->isolation_key;
+  }
+  if (params->session_usage != Cronet_UdpTunnel_SESSION_DESTINATION &&
+      params->session_usage != Cronet_UdpTunnel_SESSION_PROXY) {
+    return nullptr;
+  }
+  p.session_usage = params->session_usage;
+  p.fd = params->fd;
+  p.callback = callback;
+  p.callback_context = callback_context;
+  auto* handle = new Cronet_UdpTunnel{
+      context, std::make_unique<cronet::UdpTunnel>(context, std::move(p))};
+  context->PostTaskToNetworkThread(
+      FROM_HERE, base::BindOnce(&cronet::UdpTunnel::Start,
+                                base::Unretained(handle->tunnel.get())));
+  return handle;
+}
+
+CRONET_EXPORT void Cronet_UdpTunnel_Destroy(Cronet_UdpTunnelPtr tunnel) {
+  if (!tunnel) {
+    return;
+  }
+  RunOnNetworkThread(tunnel->context,
+                     base::BindOnce([](std::unique_ptr<cronet::UdpTunnel>) {},
+                                    std::move(tunnel->tunnel)));
+  delete tunnel;
+}
+
+CRONET_EXPORT Cronet_UdpTunnelStats
+Cronet_UdpTunnel_GetStats(Cronet_UdpTunnelPtr tunnel) {
+  Cronet_UdpTunnelStats stats = {};
+  RunOnNetworkThread(tunnel->context,
+                     base::BindOnce(
+                         [](cronet::UdpTunnel* t, Cronet_UdpTunnelStats* out) {
+                           *out = t->stats();
+                         },
+                         base::Unretained(tunnel->tunnel.get()),
+                         base::Unretained(&stats)));
+  return stats;
+}
