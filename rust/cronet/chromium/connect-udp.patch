+#include "net/base/proxy_delegate.h"
+#include "net/log/net_log_with_source.h"
+#include "net/quic/quic_chromium_client_session.h"
+#include "net/quic/quic_proxy_datagram_client_socket.h"
+#include "net/quic/quic_session_pool.h"
+
+namespace cronet {
+
+class CronetContext;
+
+// A CONNECT-UDP tunnel (RFC 9298) through an HTTP/3 proxy, made of what
+// Chrome itself uses to carry QUIC through its IP Protection proxies: a QUIC
+// session to the proxy from the engine's QuicSessionPool, a request stream
+// on it and a net::QuicProxyDatagramClientSocket, whose datagrams are HTTP
+// Datagrams (RFC 9297). What differs from Chrome is only the far end of the
+// socket: instead of a QUIC session to a site, the datagrams go to and come
+// from the embedder through one end of a socket pair, one datagram per
+// message.
+//
+// Lives on the engine's network thread from Start() on.
+class UdpTunnel : public base::MessagePumpForIO::FdWatcher {
+ public:
+  struct Params {
+    std::string proxy_host;
+    uint16_t proxy_port = 0;
+    std::string target_host;
+    uint16_t target_port = 0;
+    // Extra headers of the CONNECT-UDP request, in order.
+    std::vector<std::pair<std::string, std::string>> headers;
+    // A URL naming the tunnel's network partition; empty for none.
+    std::string isolation_key;
+    // A Cronet_UdpTunnelSessionUsage.
+    int session_usage = Cronet_UdpTunnel_SESSION_DESTINATION;
+    int fd = -1;
+    Cronet_UdpTunnelCallback callback = nullptr;
+    void* callback_context = nullptr;
+  };
+
+  UdpTunnel(CronetContext* context, Params params);
+  UdpTunnel(const UdpTunnel&) = delete;
+  UdpTunnel& operator=(const UdpTunnel&) = delete;
+  ~UdpTunnel() override;
+
+  // Starts opening the tunnel. Called once, on the network thread.
+  void Start();
+
+  // base::MessagePumpForIO::FdWatcher, for the embedder's end.
+  void OnFileCanReadWithoutBlocking(int fd) override;
+  void OnFileCanWriteWithoutBlocking(int fd) override;
+
+  Cronet_UdpTunnelStats stats() const { return stats_; }
+
+ private:
+  class Headers;
+
+  void OnSession(int rv);
+  void OnStream(int rv);
+  void OnConnected(int rv);
+  void ReadFromProxy();
+  void OnReadFromProxy(int rv);
+  // Hands one datagram from the proxy to the embedder; false once the
+  // tunnel is closed.
+  bool Deliver(int rv);
+  // Ends the tunnel with `net_error` and tells the embedder, once.
+  void Close(int net_error);
+
+  const raw_ptr<CronetContext> context_;
+  Params params_;
+  net::NetLogWithSource net_log_;
+  net::NetErrorDetails net_error_details_;
+  std::unique_ptr<Headers> headers_;
+  std::unique_ptr<net::QuicSessionRequest> session_request_;
+  std::unique_ptr<net::QuicChromiumClientSession::Handle> session_;
+  std::unique_ptr<net::QuicProxyDatagramClientSocket> socket_;
+  base::MessagePumpForIO::FdWatchController fd_watcher_;
+  scoped_refptr<net::IOBufferWithSize> up_buf_;
+  scoped_refptr<net::IOBufferWithSize> down_buf_;
+  Cronet_UdpTunnelStats stats_ = {};
+  bool closed_ = false;
+  base::WeakPtrFactory<UdpTunnel> weak_factory_{this};
+};
+
+}  // namespace cronet
+
+#endif  // COMPONENTS_CRONET_NATIVE_UDP_TUNNEL_H_
