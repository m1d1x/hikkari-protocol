@@ -5,6 +5,7 @@
 #ifndef COMPONENTS_CRONET_NATIVE_INCLUDE_CRONET_C_H_
 #define COMPONENTS_CRONET_NATIVE_INCLUDE_CRONET_C_H_
 
+#include <stddef.h>
 #include <stdint.h>
 
 #include "cronet_export.h"
@@ -111,6 +112,97 @@ CRONET_EXPORT void Cronet_Engine_SetUdpDialer(
 // Calls from Cronet's network thread schedule the close asynchronously.
 CRONET_EXPORT void Cronet_Engine_CloseAllConnections(Cronet_EnginePtr engine);
 
+// CONNECT-UDP tunnels (RFC 9298) through an HTTP/3 proxy, with the
+// datagrams as HTTP Datagrams (RFC 9297): the client Chrome uses for its own
+// QUIC through IP Protection proxies (net::QuicProxyDatagramClientSocket),
+// with the datagrams to and from the embedder instead of a site's QUIC.
+// The QUIC session to the proxy comes from the engine's session pool, so
+// the engine must have QUIC enabled; its UDP socket comes from the UDP
+// dialer when one is set.
+
+typedef struct Cronet_UdpTunnel Cronet_UdpTunnel;
+typedef Cronet_UdpTunnel* Cronet_UdpTunnelPtr;
+
+typedef struct Cronet_UdpTunnelHeader {
+  const char* key;
+  const char* value;
+} Cronet_UdpTunnelHeader;
+
+typedef struct Cronet_UdpTunnelParams {
+  // The HTTP/3 proxy.
+  const char* proxy_host;
+  uint16_t proxy_port;
+  // The target in the request's URI template; the proxy decides what it is.
+  const char* target_host;
+  uint16_t target_port;
+  // Extra headers of the CONNECT-UDP request (proxy-authorization, say).
+  const Cronet_UdpTunnelHeader* headers;
+  size_t header_count;
+  // A URL naming the tunnel's network partition: tunnels with different
+  // keys never share a QUIC session to the proxy. NULL for none.
+  const char* isolation_key;
+  // One end of a datagram socket pair (AF_UNIX, SOCK_DGRAM or
+  // SOCK_SEQPACKET). The tunnel owns it from the call on and closes it when
+  // destroyed. Every message the embedder writes to the other end is one
+  // datagram to the proxy; every datagram from the proxy is one message to
+  // read there. A datagram that does not fit (the QUIC connection cannot
+  // send it, or the embedder's end is full) is dropped and counted.
+  int fd;
+  // How the QUIC session to the proxy is used, as Chrome sees it (a
+  // Cronet_UdpTunnelSessionUsage): the packets and the certificate's fetches
+  // are those of Chrome's session to a site, or to an IP Protection proxy.
+  int session_usage;
+} Cronet_UdpTunnelParams;
+
+typedef enum Cronet_UdpTunnelSessionUsage {
+  // As Chrome's session to a site: QUIC packets of 1250 B (IPv4).
+  Cronet_UdpTunnel_SESSION_DESTINATION = 0,
+  // As Chrome's session to an IP Protection proxy: 100 B more a packet, so
+  // that a tunneled QUIC connection still has 1200 B.
+  Cronet_UdpTunnel_SESSION_PROXY = 1,
+} Cronet_UdpTunnelSessionUsage;
+
+typedef enum Cronet_UdpTunnelEvent {
+  // The tunnel carries datagrams. net_error is 0.
+  Cronet_UdpTunnel_UP = 1,
+  // The tunnel is over (it may never have been up): net_error says why.
+  // Nothing more is sent or received; the embedder still destroys it.
+  Cronet_UdpTunnel_CLOSED = 2,
+} Cronet_UdpTunnelEvent;
+
+// Called on the engine's network thread, at most once per event.
+typedef void (*Cronet_UdpTunnelCallback)(void* context,
+                                         Cronet_UdpTunnelEvent event,
+                                         int net_error);
+
+typedef struct Cronet_UdpTunnelStats {
+  // Datagrams from the embedder handed to the QUIC connection.
+  uint64_t up_sent;
+  // Datagrams from the embedder the QUIC connection would not take.
+  uint64_t up_dropped;
+  // Datagrams from the proxy.
+  uint64_t down_received;
+  // Datagrams from the proxy dropped: too big, or the embedder's end full.
+  uint64_t down_dropped;
+} Cronet_UdpTunnelStats;
+
+// Starts opening a tunnel on a started engine; returns at once. NULL when
+// the engine is not started or a parameter is missing (fd is then not
+// taken). The callback says when it is up or over.
+CRONET_EXPORT Cronet_UdpTunnelPtr
+Cronet_UdpTunnel_Create(Cronet_EnginePtr engine,
+                        const Cronet_UdpTunnelParams* params,
+                        Cronet_UdpTunnelCallback callback,
+                        void* callback_context);
+
+// Closes the tunnel and its end of the pair. When it returns, the callback
+// is not called again. Must be called before Cronet_Engine_Shutdown().
+CRONET_EXPORT void Cronet_UdpTunnel_Destroy(Cronet_UdpTunnelPtr tunnel);
+
+// The tunnel's counts so far.
+CRONET_EXPORT Cronet_UdpTunnelStats
+Cronet_UdpTunnel_GetStats(Cronet_UdpTunnelPtr tunnel);
+
 #ifdef __cplusplus
 }
 #endif
